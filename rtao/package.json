{
  "name": "rta-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:unit",
    "test:unit": "vitest run src",
    "test:pal": "vitest run tests",
    "typecheck": "tsc -b --pretty false",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "build:capture": "node scripts/build-sandbox-capture.mjs",
    "check": "npm run test:unit && npm run typecheck && npm run build:web && npm run build:capture"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.57",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
