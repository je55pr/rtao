{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["vite.config.ts", "src/**/*.ts"]
}
